#
# ESP32-S3 overrides — TinyUSB HID (native USB OTG).
#
CONFIG_TINYUSB_HID_ENABLED=y
CONFIG_TINYUSB_HID_COUNT=1

# Custom VID/PID + descriptor strings.
CONFIG_TINYUSB_DESC_CUSTOM_VID_PID=y
CONFIG_TINYUSB_DESC_USE_DEFAULT_VID=n
CONFIG_TINYUSB_DESC_USE_DEFAULT_PID=n
CONFIG_TINYUSB_DESC_CUSTOM_VID=0x303A
CONFIG_TINYUSB_DESC_CUSTOM_PID=0x8234
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0100
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="Espressif"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="ESP32 Human interface"
CONFIG_TINYUSB_DESC_SERIAL_STRING="000000"

# Keep SMP enabled on the dual-core S3 — usb_hid_task pins to core 0,
# http_cmd_task to core 1.
CONFIG_FREERTOS_UNICORE=n
